{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": false,
  "plugins": ["opencode-models-discovery"],
  "providers": {
    "algonauti": {
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.algonauti.dev/v1",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "cache": {
            "enabled": true,
            "ttlSeconds": 86400
          },
          "models": {
            "excludeBy": [
              { "field": "id", "match": "^[^/]+$" },
              { "field": "id", "match": "safeforge" }
            ]
          }
        }
      }
    }
  }
}
