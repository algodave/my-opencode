{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": false,
  "plugins": ["opencode-models-discovery"],
  "providers": {
    "algonauti": {
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.algonauti.dev/v1",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "cache": {
            "enabled": true,
            "ttlSeconds": 86400
          },
          "models": {
            "excludeBy": [
              { "field": "id", "match": "^[^/]+$" },
              { "field": "id", "match": "safeforge" }
            ]
          }
        }
      },
      "models": {
        "dov/gpt-6-sol": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] },
            "temperature": false,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "dov/gpt-6.1-sol": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] },
            "temperature": false,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "algodave/gpt-6-sol": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] },
            "temperature": false,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "algodave/gpt-6.1-sol": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] },
            "temperature": false,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "algodave/gpt-6-astra": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] },
            "temperature": false,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "algodave/claude-haiku-5-5": {
          "limit": { "context": 1000000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] },
            "temperature": false,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "algodave/claude-sonnet-5-5": {
          "limit": { "context": 1000000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] },
            "temperature": false,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
